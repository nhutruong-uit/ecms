# Sao chép thành .env rồi sửa cho phù hợp máy của bạn (.env không được commit).

# --- SQL Server (docker-compose) ---
SA_PASSWORD=Ecms@12345

# --- Kết nối của ứng dụng web ---
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ECMS
DB_DRIVER=ODBC Driver 18 for SQL Server
# Tài khoản ít quyền của ứng dụng (tạo ở database/08_security.sql – T15).
# Trước khi chạy 08_security.sql có thể tạm dùng sa.
DB_USER=ecms_app
DB_PASSWORD=App@Ecms2026
DB_TRUST_CERT=yes
# Windows dùng Windows Authentication thì đặt DB_TRUSTED=yes và bỏ trống DB_USER/DB_PASSWORD
DB_TRUSTED=no
