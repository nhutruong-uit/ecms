// ERD chi tiết các loại thuộc tính (ký hiệu Chen) – T04, vẽ lại T30 (Hình 2.2)
//   neato -n -Tpng -Gdpi=200 docs/design/erd-thuoc-tinh.dot -o docs/design/erd-thuoc-tinh.png
// Gạch chân: khoá · elip đôi: đa trị · elip nét đứt: suy diễn · elip có elip con: phức hợp · nét chấm: suy ra từ.
// Toạ độ cố định (pos, point), nét thẳng; ảnh ~18 × 25 cm, chèn khổ 15 cm chữ in ~11 pt.
graph ATTR {
  graph [splines=line, outputorder=edgesfirst, pad=0.12, bgcolor="white", fontname="Times New Roman,"];
  node [fontname="Times New Roman,", fontsize=14, style=filled, shape=ellipse, fillcolor="#ffffff", color="#64748b", penwidth=1.2, height=0.38, margin="0.06,0.02"];
  edge [fontname="Times New Roman,", fontsize=13, color="#94a3b8", penwidth=1.2];
  nv_ma [pos="50,702!", label=<<u>MaNV</u>>];
  nv_ht [pos="140,702!", label="Họ tên"];
  nv_cv [pos="230,702!", label="Chức vụ"];
  NHANVIEN [pos="140,648!", label="NHANVIEN", shape=box, fillcolor="#dbeafe", color="#1d4ed8", fontsize=15, height=0.42, margin="0.12,0.05"];
  nv_luong [pos="295,648!", label="Lương cơ bản"];
  isa [pos="140,593!", label="ISA", shape=triangle, fillcolor="#dcfce7", color="#15803d", fontsize=13, width=0.8, height=0.55];
  GIAOVIEN [pos="140,538!", label="GIAOVIEN", shape=box, fillcolor="#dbeafe", color="#1d4ed8", fontsize=15, height=0.42, margin="0.12,0.05"];
  gv_cc [pos="305,538!", label="Chứng chỉ", peripheries=2];
  gv_loai [pos="60,484!", label="Loại GV"];
  gv_dg [pos="175,484!", label="Đơn giá buổi"];
  gv_tencc [pos="425,590!", label="Tên CC"];
  gv_diem [pos="440,538!", label="Điểm"];
  gv_ngay [pos="425,486!", label="Ngày cấp"];
  lop_ma [pos="100,432!", label=<<u>MaLop</u>>];
  lop_kg [pos="100,380!", label="Ngày khai giảng"];
  LOPHOC [pos="255,406!", label="LOPHOC", shape=box, fillcolor="#dbeafe", color="#1d4ed8", fontsize=15, height=0.42, margin="0.12,0.05"];
  lop_max [pos="410,432!", label="Sĩ số tối đa"];
  lop_ss [pos="410,380!", label="Sĩ số hiện tại", style="filled,dashed"];
  dk_ngay [pos="75,330!", label="Ngày ĐK"];
  dk_hp [pos="60,284!", label="Học phí"];
  dk_gg [pos="75,238!", label="Giảm giá"];
  dk_tt [pos="175,208!", label="Thành tiền", style="filled,dashed"];
  DANGKY [pos="255,284!", label="ĐĂNG KÝ", shape=diamond, fillcolor="#fde68a", color="#b45309", fontsize=15, width=1.55, height=0.62];
  dk_gk [pos="435,330!", label="Điểm GK"];
  dk_ck [pos="450,284!", label="Điểm CK"];
  dk_kq [pos="435,238!", label="Kết quả"];
  dk_tb [pos="335,208!", label="Điểm TB", style="filled,dashed"];
  HOCVIEN [pos="255,152!", label="HOCVIEN", shape=box, fillcolor="#dbeafe", color="#1d4ed8", fontsize=15, height=0.42, margin="0.12,0.05"];
  hv_ma [pos="100,152!", label=<<u>MaHV</u>>];
  hv_sdt [pos="410,152!", label="SĐT"];
  hv_hoten [pos="70,94!", label="Họ tên"];
  hv_ns [pos="180,94!", label="Ngày sinh"];
  hv_tuoi [pos="290,94!", label="Tuổi", style="filled,dashed"];
  hv_dc [pos="400,94!", label="Địa chỉ"];
  hv_tp [pos="480,70!", label="Tỉnh/TP"];
  hv_ho [pos="35,36!", label="Họ"];
  hv_ten [pos="110,36!", label="Tên"];
  hv_sn [pos="232,20!", label="Số nhà"];
  hv_px [pos="325,20!", label="Phường/Xã"];
  hv_qh [pos="440,20!", label="Quận/Huyện"];
  NHANVIEN -- nv_ma;
  NHANVIEN -- nv_ht;
  NHANVIEN -- nv_cv;
  NHANVIEN -- nv_luong;
  NHANVIEN -- isa;
  isa -- GIAOVIEN;
  GIAOVIEN -- gv_loai;
  GIAOVIEN -- gv_dg;
  GIAOVIEN -- gv_cc;
  gv_cc -- gv_tencc;
  gv_cc -- gv_diem;
  gv_cc -- gv_ngay;
  LOPHOC -- lop_ma;
  LOPHOC -- lop_kg;
  LOPHOC -- lop_max;
  LOPHOC -- lop_ss;
  DANGKY -- dk_ngay;
  DANGKY -- dk_hp;
  DANGKY -- dk_gg;
  DANGKY -- dk_tt;
  DANGKY -- dk_gk;
  DANGKY -- dk_ck;
  DANGKY -- dk_kq;
  DANGKY -- dk_tb;
  HOCVIEN -- hv_ma;
  HOCVIEN -- hv_sdt;
  HOCVIEN -- hv_hoten;
  HOCVIEN -- hv_ns;
  HOCVIEN -- hv_tuoi;
  HOCVIEN -- hv_dc;
  hv_hoten -- hv_ho;
  hv_hoten -- hv_ten;
  hv_dc -- hv_sn;
  hv_dc -- hv_px;
  hv_dc -- hv_qh;
  hv_dc -- hv_tp;
  HOCVIEN -- DANGKY [color="#475569", penwidth=1.4, xlabel="(0,n)"];
  DANGKY -- LOPHOC [color="#475569", penwidth=1.4, xlabel="(0,n)"];
  hv_ns -- hv_tuoi [style=dotted, color="#64748b", xlabel="suy ra"];
}
