// Sơ đồ CSDL ECMS – Danh mục và đào tạo. Sinh từ sys.columns / sys.foreign_keys sau khi chạy run_all.
// Mỗi bảng chỉ liệt kê cột khoá (PK, FK); các cột còn lại ở Phụ lục C. ✱: NOT NULL; ô xám: bảng thuộc nhóm còn lại.
// Dựng: dot -Tpng -Gdpi=200 db-diagram-1.dot -o db-diagram-1.png
digraph DB {
  rankdir=LR; nodesep=0.2; ranksep=0.45; splines=true; fontname="Arial";
  node [shape=plain, fontname="Arial", fontsize=16]; edge [color="#64748b", arrowhead=crow, arrowtail=tee, dir=both];
  CHINHANH [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>CHINHANH</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>MaCN</B> ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaNVQuanLy</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 4 cột khác</I></FONT></TD></TR></TABLE>>];
  NHANVIEN [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>NHANVIEN</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>MaNV</B> ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaCN ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaNVQuanLy</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 11 cột khác</I></FONT></TD></TR></TABLE>>];
  GIAOVIEN [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>GIAOVIEN</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT"><B>MaGV</B> ✱</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 4 cột khác</I></FONT></TD></TR></TABLE>>];
  CHUNGCHI_GV [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>CHUNGCHI_GV</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT"><B>MaGV</B> ✱</TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>TenChungChi</B> ✱</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 3 cột khác</I></FONT></TD></TR></TABLE>>];
  PHONGHOC [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>PHONGHOC</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT"><B>MaCN</B> ✱</TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>MaPhong</B> ✱</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 2 cột khác</I></FONT></TD></TR></TABLE>>];
  CAHOC [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>CAHOC</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>MaCa</B> ✱</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 3 cột khác</I></FONT></TD></TR></TABLE>>];
  NGAYLE [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>NGAYLE</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>Ngay</B> ✱</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 1 cột khác</I></FONT></TD></TR></TABLE>>];
  CHUONGTRINH [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>CHUONGTRINH</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>MaCT</B> ✱</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 3 cột khác</I></FONT></TD></TR></TABLE>>];
  KHOAHOC [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>KHOAHOC</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>MaKH</B> ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaCT ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaKHTienQuyet</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 7 cột khác</I></FONT></TD></TR></TABLE>>];
  LOPHOC [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>LOPHOC</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>MaLop</B> ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaKH ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaCN ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaGV ✱</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 6 cột khác</I></FONT></TD></TR></TABLE>>];
  LICHHOC [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>LICHHOC</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT"><B>MaLop</B> ✱</TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>Thu</B> ✱</TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT"><B>MaCa</B> ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaCN ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaPhong ✱</TD></TR></TABLE>>];
  BUOIHOC [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>BUOIHOC</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT"><B>MaLop</B> ✱</TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>STT</B> ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaCa ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaGVDay</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 4 cột khác</I></FONT></TD></TR></TABLE>>];
  BANGLUONG [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>BANGLUONG</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>Thang</B> ✱</TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT"><B>MaGV</B> ✱</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 5 cột khác</I></FONT></TD></TR></TABLE>>];
  GIAOVIEN -> BANGLUONG [tooltip="FK_BANGLUONG_GIAOVIEN"];
  CAHOC -> BUOIHOC [tooltip="FK_BUOIHOC_CAHOC"];
  GIAOVIEN -> BUOIHOC [tooltip="FK_BUOIHOC_GIAOVIEN"];
  LOPHOC -> BUOIHOC [tooltip="FK_BUOIHOC_LOPHOC"];
  NHANVIEN -> CHINHANH [tooltip="FK_CHINHANH_QuanLy"];
  GIAOVIEN -> CHUNGCHI_GV [tooltip="FK_CHUNGCHI_GV_GIAOVIEN"];
  NHANVIEN -> GIAOVIEN [tooltip="FK_GIAOVIEN_NHANVIEN"];
  CHUONGTRINH -> KHOAHOC [tooltip="FK_KHOAHOC_CHUONGTRINH"];
  KHOAHOC -> KHOAHOC [tooltip="FK_KHOAHOC_TienQuyet"];
  CAHOC -> LICHHOC [tooltip="FK_LICHHOC_CAHOC"];
  LOPHOC -> LICHHOC [tooltip="FK_LICHHOC_LOPHOC"];
  PHONGHOC -> LICHHOC [tooltip="FK_LICHHOC_PHONGHOC"];
  CHINHANH -> LOPHOC [tooltip="FK_LOPHOC_CHINHANH"];
  GIAOVIEN -> LOPHOC [tooltip="FK_LOPHOC_GIAOVIEN"];
  KHOAHOC -> LOPHOC [tooltip="FK_LOPHOC_KHOAHOC"];
  CHINHANH -> NHANVIEN [tooltip="FK_NHANVIEN_CHINHANH"];
  NHANVIEN -> NHANVIEN [tooltip="FK_NHANVIEN_QuanLy"];
  CHINHANH -> PHONGHOC [tooltip="FK_PHONGHOC_CHINHANH"];
}
