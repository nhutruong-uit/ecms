// Sơ đồ CSDL ECMS – Học viên, học tập, tài chính và hệ thống. Sinh từ sys.columns / sys.foreign_keys sau khi chạy run_all.
// Mỗi bảng chỉ liệt kê cột khoá (PK, FK); các cột còn lại ở Phụ lục C. ✱: NOT NULL; ô xám: bảng thuộc nhóm còn lại.
// Dựng: dot -Tpng -Gdpi=200 db-diagram-2.dot -o db-diagram-2.png
digraph DB {
  rankdir=LR; nodesep=0.2; ranksep=0.45; splines=true; fontname="Arial";
  node [shape=plain, fontname="Arial", fontsize=16]; edge [color="#64748b", arrowhead=crow, arrowtail=tee, dir=both];
  HOCVIEN [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>HOCVIEN</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>MaHV</B> ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaCN ✱</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 15 cột khác</I></FONT></TD></TR></TABLE>>];
  KIEMTRA_DAUVAO [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>KIEMTRA_DAUVAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>MaKT</B> ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaHV ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaKHDeXuat</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaNVCham</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 3 cột khác</I></FONT></TD></TR></TABLE>>];
  DANGKY [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>DANGKY</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>MaDK</B> ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaHV ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaLop ✱</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 11 cột khác</I></FONT></TD></TR></TABLE>>];
  DIEMDANH [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>DIEMDANH</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT"><B>MaDK</B> ✱</TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT"><B>MaLop</B> ✱</TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT"><B>STT</B> ✱</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 2 cột khác</I></FONT></TD></TR></TABLE>>];
  CANHBAO_CHUYENCAN [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>CANHBAO_CHUYENCAN</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>MaCB</B> ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaDK ✱</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 6 cột khác</I></FONT></TD></TR></TABLE>>];
  PHIEUTHU [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>PHIEUTHU</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>MaPT</B> ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaHV ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaNV ✱</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 6 cột khác</I></FONT></TD></TR></TABLE>>];
  CT_PHIEUTHU [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>CT_PHIEUTHU</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT"><B>MaPT</B> ✱</TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT"><B>MaDK</B> ✱</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 1 cột khác</I></FONT></TD></TR></TABLE>>];
  TAIKHOAN [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>TAIKHOAN</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>TenDangNhap</B> ✱</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaNV</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">MaHV</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 8 cột khác</I></FONT></TD></TR></TABLE>>];
  NHATKY [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#1d4ed8" COLSPAN="2"><FONT COLOR="white"><B>NHATKY</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT"><B>MaNK</B> ✱</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#475569"><I>+ 8 cột khác</I></FONT></TD></TR></TABLE>>];
  BUOIHOC [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e2e8f0"><FONT COLOR="#334155"><B>BUOIHOC</B></FONT></TD></TR></TABLE>>];
  CHINHANH [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e2e8f0"><FONT COLOR="#334155"><B>CHINHANH</B></FONT></TD></TR></TABLE>>];
  KHOAHOC [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e2e8f0"><FONT COLOR="#334155"><B>KHOAHOC</B></FONT></TD></TR></TABLE>>];
  LOPHOC [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e2e8f0"><FONT COLOR="#334155"><B>LOPHOC</B></FONT></TD></TR></TABLE>>];
  NHANVIEN [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e2e8f0"><FONT COLOR="#334155"><B>NHANVIEN</B></FONT></TD></TR></TABLE>>];
  DANGKY -> CANHBAO_CHUYENCAN [tooltip="FK_CANHBAO_DANGKY"];
  DANGKY -> CT_PHIEUTHU [tooltip="FK_CT_PHIEUTHU_DANGKY"];
  PHIEUTHU -> CT_PHIEUTHU [tooltip="FK_CT_PHIEUTHU_PHIEUTHU"];
  HOCVIEN -> DANGKY [tooltip="FK_DANGKY_HOCVIEN"];
  LOPHOC -> DANGKY [tooltip="FK_DANGKY_LOPHOC"];
  BUOIHOC -> DIEMDANH [tooltip="FK_DIEMDANH_BUOIHOC"];
  DANGKY -> DIEMDANH [tooltip="FK_DIEMDANH_DANGKY"];
  CHINHANH -> HOCVIEN [tooltip="FK_HOCVIEN_CHINHANH"];
  HOCVIEN -> KIEMTRA_DAUVAO [tooltip="FK_KIEMTRA_HOCVIEN"];
  KHOAHOC -> KIEMTRA_DAUVAO [tooltip="FK_KIEMTRA_KHOAHOC"];
  NHANVIEN -> KIEMTRA_DAUVAO [tooltip="FK_KIEMTRA_NHANVIEN"];
  HOCVIEN -> PHIEUTHU [tooltip="FK_PHIEUTHU_HOCVIEN"];
  NHANVIEN -> PHIEUTHU [tooltip="FK_PHIEUTHU_NHANVIEN"];
  HOCVIEN -> TAIKHOAN [tooltip="FK_TAIKHOAN_HOCVIEN"];
  NHANVIEN -> TAIKHOAN [tooltip="FK_TAIKHOAN_NHANVIEN"];
}
