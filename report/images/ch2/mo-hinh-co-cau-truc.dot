// Hình 2.4 – Cùng dữ liệu ghi danh của chi nhánh CN01 theo mô hình phân cấp (a) và mô hình mạng (b)
// Dữ liệu thật trong 02_seed.sql: học viên HV0010, HV0013 cùng học hai lớp IEF-2501 và IE55-2602.
// Dựng: dot -Tpng -Gdpi=200 mo-hinh-co-cau-truc.dot -o mo-hinh-co-cau-truc.png
digraph CoCauTruc {
  rankdir=TB; newrank=true; nodesep=0.18; ranksep=0.45; fontname="Arial"; fontsize=17;
  node [fontname="Arial", fontsize=16, shape=box, style="rounded,filled", color="#1d4ed8", fillcolor="#dbeafe", margin="0.08,0.05"];
  edge [fontname="Arial", fontsize=14, color="#475569", arrowsize=0.8];

  subgraph cluster_a {
    label="(a) Phân cấp: mỗi bản ghi con có đúng một cha"; labeljust=l; color="#94a3b8"; style=dashed;
    a_cn  [label="CN01", fillcolor="#bfdbfe"];
    a_l1  [label="IEF-2501"];
    a_l2  [label="IE55-2602"];
    a_h1  [label="HV0010"];
    a_h2  [label="HV0013"];
    a_h1b [label="HV0010\n(bản sao)", color="#b91c1c", fillcolor="#fee2e2", style="rounded,filled,dashed"];
    a_h2b [label="HV0013\n(bản sao)", color="#b91c1c", fillcolor="#fee2e2", style="rounded,filled,dashed"];
    a_cn -> a_l1; a_cn -> a_l2;
    a_l1 -> a_h1; a_l1 -> a_h2;
    a_l2 -> a_h1b; a_l2 -> a_h2b;
  }

  subgraph cluster_b {
    label="(b) Mạng: tập hợp chủ – thành viên"; labeljust=l; color="#94a3b8"; style=dashed;
    b_cn  [label="CHI NHÁNH", fillcolor="#bfdbfe"];
    b_lop [label="LỚP"];
    b_hv  [label="HỌC VIÊN"];
    b_dk  [label="ĐĂNG KÝ", fillcolor="#fef3c7", color="#b45309"];
    b_cn -> b_lop [label="CN_LOP "];
    b_cn -> b_hv  [label=" CN_HV"];
    b_lop -> b_dk [label="LOP_DK "];
    b_hv -> b_dk  [label=" HV_DK"];
  }
  {rank=same; a_cn; b_cn}
}
