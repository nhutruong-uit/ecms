// Thiết kế document MongoDB của ECMS: nhúng và tham chiếu (T30) – nosql/migrate.py
//   dot -Tpng -Gdpi=200 mongo-document.dot -o mongo-document.png
digraph Mongo {
  rankdir=TB; nodesep=0.5; ranksep=0.5; fontname="Arial"; bgcolor="white"; newrank=true;
  node [shape=plain, fontname="Arial", fontsize=13]; edge [fontname="Arial", fontsize=12, arrowsize=0.8];

  pt [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f8fafc">
    <TR><TD BGCOLOR="#16a34a"><FONT COLOR="white"><B>phieu_thu</B> (501)</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="hv">_id: SoPhieu · hoc_vien<BR ALIGN="LEFT"/>ngay_thu · tong_tien<BR ALIGN="LEFT"/></TD></TR>
    <TR><TD ALIGN="LEFT" BGCOLOR="#dcfce7" PORT="ct">chi_tiet[ ] (508)<BR ALIGN="LEFT"/>{ma_dk, lop, chi_nhanh, so_tien}<BR ALIGN="LEFT"/></TD></TR>
  </TABLE>>];

  lg [shape=box, style="rounded", color="#94a3b8", fontsize=12, label=<<TABLE BORDER="0" CELLSPACING="3">
    <TR><TD BGCOLOR="#dcfce7" WIDTH="18"> </TD><TD ALIGN="LEFT">nhúng (embedded)</TD></TR>
    <TR><TD BGCOLOR="#fde68a" WIDTH="18"> </TD><TD ALIGN="LEFT">nhúng bản sao – đổi phải sửa nhiều document</TD></TR>
    <TR><TD><FONT COLOR="#2563eb">- - ▶</FONT></TD><TD ALIGN="LEFT">tham chiếu theo _id (không có khoá ngoại)</TD></TR></TABLE>>];

  hv [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f8fafc">
    <TR><TD BGCOLOR="#16a34a" COLSPAN="2"><FONT COLOR="white"><B>hoc_vien</B> (349)</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" COLSPAN="2" PORT="top">_id: "HV0019" · ho_ten {ho, ten} · sdt · chi_nhanh</TD></TR>
    <TR><TD ALIGN="LEFT" COLSPAN="2" BGCOLOR="#dcfce7">dia_chi {so_nha, phuong, quan, tinh}</TD></TR>
    <TR><TD ALIGN="LEFT" COLSPAN="2" BGCOLOR="#dcfce7">kiem_tra[ ] (357) {ngay, diem_tong, ky_nang {listening, …}}</TD></TR>
    <TR><TD ALIGN="LEFT" BGCOLOR="#dcfce7" ROWSPAN="2" PORT="dk">dang_ky[ ]<BR ALIGN="LEFT"/>(539)</TD><TD ALIGN="LEFT" BGCOLOR="#dcfce7">ma_dk, lop, khoa_hoc, chi_nhanh,<BR ALIGN="LEFT"/>hoc_phi {thanh_tien, da_thu: Decimal128}, diem<BR ALIGN="LEFT"/></TD></TR>
    <TR><TD ALIGN="LEFT" BGCOLOR="#bbf7d0">diem_danh[ ] (10.063) {buoi, ngay, trang_thai}</TD></TR>
  </TABLE>>];

  lop [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f8fafc">
    <TR><TD BGCOLOR="#16a34a"><FONT COLOR="white"><B>lop_hoc</B> (25)</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="kh">_id: MaLop · khoa_hoc · chi_nhanh · si_so</TD></TR>
    <TR><TD ALIGN="LEFT" BGCOLOR="#dcfce7">lich[ ] {thu, ca, gio, phong}</TD></TR>
    <TR><TD ALIGN="LEFT" BGCOLOR="#fde68a">giao_vien {ma, ho_ten, loai}</TD></TR>
  </TABLE>>];

  kh [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f8fafc">
    <TR><TD BGCOLOR="#16a34a"><FONT COLOR="white"><B>khoa_hoc</B> (12)</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="id">_id: MaKH · ten · hoc_phi</TD></TR>
    <TR><TD ALIGN="LEFT" PORT="tq">tien_quyet</TD></TR>
  </TABLE>>];

  { rank=same; pt; lg; }
  { rank=same; lop; kh; }
  pt:hv -> hv:top [color="#2563eb", style=dashed, label=" hoc_vien "];
  hv:dk -> lop:kh [color="#2563eb", style=dashed, label=" dang_ky.lop "];
  lop:kh -> kh:id [color="#2563eb", style=dashed, label=" khoa_hoc "];
  kh:tq:e -> kh:id:e [color="#2563eb", style=dashed, label=" tiên quyết "];
  lg -> hv [style=invis];
}
