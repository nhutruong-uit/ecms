// Luồng giao dịch của sp_ThuHocPhi (Chương 3, mục 3.3.1) – database/05_procedures.sql
//   dot -Tpng -Gdpi=200 report/images/ch3/giao-dich-thu-hoc-phi.dot -o report/images/ch3/giao-dich-thu-hoc-phi.png
// Luồng chính một cột, nhánh phụ bên phải; đường thẳng / gấp khúc; phông Times New Roman như thân báo cáo.
digraph ThuHocPhi {
  graph [rankdir=TB, splines=polyline, nodesep=0.3, ranksep=0.24, bgcolor="white", compound=true, newrank=true,
         fontname="Times New Roman,"];
  node  [fontname="Times New Roman,", fontsize=14, shape=box, style="filled,rounded", color="#94a3b8", fillcolor="#f1f5f9",
         fontcolor="#0f172a", margin="0.14,0.07"];
  edge  [fontname="Times New Roman,", fontsize=14, color="#475569", arrowsize=0.75, penwidth=1.2];

  tc   [label="@@TRANCOUNT\n= 0 ?", shape=diamond, style="filled", fillcolor="#fef3c7", margin="0.04,0.02"];
  mo   [label="SET XACT_ABORT ON\nBEGIN\nTRANSACTION", fillcolor="#dbeafe"];
  sv   [label="SAVE\nTRANSACTION\n(người gọi đã\nmở giao dịch)", fillcolor="#dbeafe"];
  subgraph cluster_try {
    label="BEGIN TRY … END TRY"; labeljust=l; labelloc=b; fontsize=14; fontcolor="#1f3864"; style="rounded"; color="#cbd5e1";
    yc   [label="@MaYeuCau\nđã có phiếu?\n(UPDLOCK, HOLDLOCK)", fillcolor="#fef3c7"];
    kt   [label="JSON hợp lệ (50010)\nkế toán / quản lý (50011)\nngười lập đang đăng nhập (50015)\nhọc viên trong phạm vi\nchi nhánh (50097)", fillcolor="#ede9fe"];
    khoa [label="Khoá DANGKY\n(UPDLOCK, HOLDLOCK)\nđúng học viên (50012)\nsố tiền > 0 (50013)\n≤ số còn nợ (50014)", fillcolor="#ede9fe"];
    ghi  [label="INSERT PHIEUTHU,\nCT_PHIEUTHU · trigger:\ntổng tiền, học phí, NHATKY", fillcolor="#e0f2fe"];
    ct   [label="COMMIT\n(nếu tự mở giao dịch)", fillcolor="#dcfce7"];
  }
  cu   [label="cùng học viên →\ntrả phiếu cũ (RETURN 1),\nkhông lập trùng\nhọc viên khác → 50016", fillcolor="#dcfce7"];
  loi  [label="lỗi ở bất kỳ bước nào\n→ BEGIN CATCH\nXACT_STATE() = -1\nhoặc tự mở giao dịch\n→ ROLLBACK toàn bộ\nngược lại → ROLLBACK\nvề điểm lưu\nTHROW lỗi gốc", fillcolor="#fee2e2"];

  tc -> mo [label=" có"];
  tc -> sv [label=" không"];
  mo -> yc; sv -> yc;
  yc -> cu [label=" có"];
  yc -> kt [label=" chưa"];
  kt -> khoa -> ghi -> ct;
  khoa -> loi [ltail=cluster_try, style=dashed, color="#dc2626", fontcolor="#dc2626"];
  {rank=same; mo; sv}
  {rank=same; yc; cu}
  {rank=same; khoa; loi}
}
